<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    </PropertyGroup>

  <ItemGroup>
    <None Remove="Web\mythtv.html" />
    <None Remove="Web\mythtv.js" />
    <EmbeddedResource Include="Web\mythtv.html" />
    <EmbeddedResource Include="Web\mythtv.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.*-*" />
    <PackageReference Include="Jellyfin.Extensions" Version="12.*-*" />
  </ItemGroup>

</Project>
